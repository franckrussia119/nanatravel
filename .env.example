# Copy this file to .env for local development.
# In Coolify, set these under your app's "Environment Variables" tab instead.

# --- Contact form (app/api/contact/route.ts) ---
# Optional: if RESEND_API_KEY and CONTACT_NOTIFY_EMAIL are both unset, enquiries
# are just logged to the server console instead of emailed.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL="NanaTravelServices <onboarding@resend.dev>"

# --- Database (prisma/schema.prisma) ---
# Not currently used by any page or API route in this app (no models are
# defined and nothing imports lib/db.ts yet). Left here for when/if you add
# a database-backed feature. Safe to leave unset until then.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
